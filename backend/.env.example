# ── App ───────────────────────────────────────────────
APP_NAME=CareerAI
APP_VERSION=1.0.0
DEBUG=true
PORT=8000

# ── Security ──────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database (PostgreSQL) ─────────────────────────────
DATABASE_URL=postgresql://postgres:leon1427@localhost:5432/careerai

# SQLite fallback for local dev (no Postgres needed):
# DATABASE_URL=sqlite:///./careerai.db

# ── CORS ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Uploads ──────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
